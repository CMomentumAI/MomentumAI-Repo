# Momentum — environment variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# In Cloud Run, set these as environment variables (via Secret Manager or
# the Cloud Run service configuration). Every variable listed here (except
# ELEVENLABS_VOICE_ID) is REQUIRED.

# ─── Authentication ─────────────────────────────────────────────────────────────
# Min 32 characters. Generate with:
#   openssl rand -base64 32
JWT_SECRET=

# ─── Google Cloud Storage ────────────────────────────────────────────────────────
# Create a private GCS bucket in your Google Cloud project.
# The service account running the backend needs these IAM roles on the bucket:
#   roles/storage.objectAdmin    (read, write, delete objects)
#   iam.serviceAccountTokenCreator (required for generating signed URLs)
#
# Credentials are resolved automatically:
#   Cloud Run:  the service account assigned to the Cloud Run service
#   Local dev:  set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
#               or run: gcloud auth application-default login
#
GCS_BUCKET_NAME=momentum-patient-data
GCS_PROJECT_ID=your-gcp-project-id

# ─── AI Services ────────────────────────────────────────────────────────────────
# Perplexity — appointment transcript summarization
# Get key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Google Gemini — RAG embedding index + chat + form auto-fill
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ElevenLabs — text-to-speech audio generation
# Get key at: https://elevenlabs.io/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: pin a specific ElevenLabs voice ID.
# Defaults to "Rachel" (voice ID: 21m00Tcm4TlvDq8ikWAM) if not set.
ELEVENLABS_VOICE_ID=

# ─── OMI Wearable Webhook ───────────────────────────────────────────────────────
# HMAC-SHA256 secret shared with the OMI device cloud.
# Min 32 characters. Generate with:
#   openssl rand -base64 32
OMI_WEBHOOK_SECRET=

# ─── Cross-origin / CORS (Vercel frontend <-> Cloud Run backend) ─────────────────
#
# CORS_ALLOWED_ORIGINS — comma-separated list of exact origins the browser is
#   allowed to call. Set this in Cloud Run env for production.
#   Local dev origins (localhost 3000/3001/5173) are always allowed even if
#   this var is empty, so you can leave it blank during local development.
#
#   Examples:
#     Single production origin:
#       CORS_ALLOWED_ORIGINS=https://momentum.vercel.app
#     Production + preview deployments:
#       CORS_ALLOWED_ORIGINS=https://momentum.vercel.app,https://momentum-pr-42.vercel.app
#
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# CORS_ALLOW_CREDENTIALS — set to "true" only when the frontend needs to send
#   cookies or HTTP authentication credentials (e.g. session-cookie auth).
#   Leave as "false" (or unset) for the default Bearer JWT model.
#   When "true", the frontend fetch() calls must include: credentials: "include"
#
CORS_ALLOW_CREDENTIALS=false
