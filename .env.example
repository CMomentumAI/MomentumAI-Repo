# Momentum — environment variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# In Vercel, set these in Project Settings → Environment Variables.
# Every variable listed here (except ELEVENLABS_VOICE_ID) is REQUIRED.

# ─── Authentication ─────────────────────────────────────────────────────────────
# Min 32 characters. Generate with:
#   openssl rand -base64 32
JWT_SECRET=

# ─── AWS S3 ─────────────────────────────────────────────────────────────────────
# Create a private S3 bucket in your AWS account.
# The IAM user needs: s3:GetObject, s3:PutObject, s3:DeleteObject, s3:ListBucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=momentum-patient-data

# ─── AI Services ────────────────────────────────────────────────────────────────
# Perplexity — appointment transcript summarization
# Get key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Google Gemini — RAG embedding index + chat + form auto-fill
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ElevenLabs — text-to-speech audio generation
# Get key at: https://elevenlabs.io/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: pin a specific ElevenLabs voice ID.
# Defaults to "Rachel" (voice ID: 21m00Tcm4TlvDq8ikWAM) if not set.
ELEVENLABS_VOICE_ID=

# ─── OMI Wearable Webhook ───────────────────────────────────────────────────────
# HMAC-SHA256 secret shared with the OMI device cloud.
# Min 32 characters. Generate with:
#   openssl rand -base64 32
OMI_WEBHOOK_SECRET=

# ─── Optional cross-origin / CORS ────────────────────────────────────────────────
#
# Same-origin is the default and recommended deployment model:
#   Next.js app + API route handlers on one Vercel origin.
# In that model you can leave both CORS vars blank.
#
# CORS_ALLOWED_ORIGINS — only needed if another origin must call /api/** from
# a browser. Local dev origins (localhost 3000/3001/5173) are always allowed
# even if this var is empty.
#
#   Examples:
#     Single production origin:
#       CORS_ALLOWED_ORIGINS=https://momentum.vercel.app
#     Production + preview deployments:
#       CORS_ALLOWED_ORIGINS=https://momentum.vercel.app,https://momentum-pr-42.vercel.app
#
CORS_ALLOWED_ORIGINS=

# CORS_ALLOW_CREDENTIALS — set to "true" only when cross-origin callers send
#   cookies or HTTP authentication credentials (e.g. session-cookie auth).
#   Leave as "false" (or unset) for the default Bearer JWT model.
#   When "true", browser fetch() calls must include: credentials: "include"
#
CORS_ALLOW_CREDENTIALS=false
